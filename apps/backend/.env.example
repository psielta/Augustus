# Copie este arquivo para .env (mesmo diretorio) e preencha; .env nao e commitado.

# AUGUSTUS_DB_USERNAME / AUGUSTUS_DB_PASSWORD / AUGUSTUS_DB_ROOT_PASSWORD:
# Credenciais do MySQL local (docker compose up -d).
AUGUSTUS_DB_USERNAME=augustus
AUGUSTUS_DB_PASSWORD=augustus
AUGUSTUS_DB_ROOT_PASSWORD=root

# AUGUSTUS_JWT_SECRET: string aleatoria com pelo menos 32 caracteres.
AUGUSTUS_JWT_SECRET=

# AUGUSTUS_MAIL_HOST: host SMTP. Em desenvolvimento, use Mailpit via Docker.
AUGUSTUS_MAIL_HOST=localhost

# AUGUSTUS_MAIL_PORT: porta SMTP. Mailpit usa 1025; Gmail usa 587.
AUGUSTUS_MAIL_PORT=1025

# AUGUSTUS_MAIL_USERNAME: vazio para Mailpit; para Gmail, email da conta que envia a verificacao.
AUGUSTUS_MAIL_USERNAME=

# AUGUSTUS_MAIL_PASSWORD: vazio para Mailpit; para Gmail, App Password de https://myaccount.google.com/apppasswords (NUNCA a senha normal).
AUGUSTUS_MAIL_PASSWORD=

# AUGUSTUS_MAIL_FROM: remetente exibido no email.
AUGUSTUS_MAIL_FROM=noreply@augustus.local

# Flags SMTP. Mailpit nao usa autenticacao nem STARTTLS; Gmail exige true.
AUGUSTUS_MAIL_SMTP_AUTH=false
AUGUSTUS_MAIL_STARTTLS_ENABLE=false
AUGUSTUS_MAIL_STARTTLS_REQUIRED=false

# AUGUSTUS_VERIFICACAO_URL: URL base do link clicavel de verificacao de email.
AUGUSTUS_VERIFICACAO_URL=http://localhost:8080/api/auth/verify-email
