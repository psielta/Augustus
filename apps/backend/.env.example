# Copie este arquivo para .env (mesmo diretorio) e preencha; .env nao e commitado.

# AUGUSTUS_JWT_SECRET: string aleatoria com pelo menos 32 caracteres.
AUGUSTUS_JWT_SECRET=

# AUGUSTUS_MAIL_HOST: host SMTP; para Gmail use smtp.gmail.com.
AUGUSTUS_MAIL_HOST=smtp.gmail.com

# AUGUSTUS_MAIL_PORT: porta SMTP com STARTTLS; para Gmail use 587.
AUGUSTUS_MAIL_PORT=587

# AUGUSTUS_MAIL_USERNAME: email da conta Gmail que envia a verificacao.
AUGUSTUS_MAIL_USERNAME=

# AUGUSTUS_MAIL_PASSWORD: Gmail App Password de https://myaccount.google.com/apppasswords (NUNCA a senha normal).
AUGUSTUS_MAIL_PASSWORD=

# AUGUSTUS_MAIL_FROM: remetente exibido no email; normalmente igual ao AUGUSTUS_MAIL_USERNAME.
AUGUSTUS_MAIL_FROM=

# AUGUSTUS_VERIFICACAO_URL: URL base do link clicavel de verificacao de email.
AUGUSTUS_VERIFICACAO_URL=http://localhost:8080/api/auth/verify-email
